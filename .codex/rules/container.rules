# Allow only the explicit container recipes in justfile.
prefix_rule(
    pattern = ["just", [
        "container-build-image",
        "container-test",
        "container-test-all",
        "container-test-unit",
        "container-test-integration",
        "container-pre-commit",
    ]],
    decision = "allow",
    justification = "The user permits the project's container test and pre-commit recipes without approval.",
    match = [
        "just container-build-image",
        "just container-build-image --no-cache --pull=always",
        "just container-test",
        "just container-test-all",
        "just container-test -q -k 'config or launcher'",
        "just container-test-unit",
        "just container-test-integration",
        "just container-pre-commit",
        "just container-pre-commit justfile tests/Containerfile",
    ],
    not_match = [
        "just run",
        "just test",
        "just test-all",
        "just pre-commit",
        "just _container-run test",
        "just container-shell",
        "just container-build",
        "just container-clean",
        "just container-lint",
        "just container-format",
        "just container-typecheck",
        "just container-versions",
        "just --justfile other.just container-test",
        "podman run",
    ],
)
