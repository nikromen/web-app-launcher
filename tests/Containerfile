FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y \
    dbus-libs \
    fontconfig \
    git \
    just \
    libatomic \
    python3 \
    qt6-qtsvg \
    libX11-xcb \
    libxcb \
    xcb-util-cursor \
    libxkbcommon \
    libxkbcommon-x11 \
    mesa-libEGL \
    mesa-libGL \
    uv \
    && dnf clean all

WORKDIR /workspace
CMD ["/bin/bash"]
